---
import '../styles/global.css';
const { title = 'Caspy’s Prompt Heist — A little charm. A little mischief.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Three prompts. One stubborn ghost. Can you sweet-talk Caspy out of his candy? Play the Halloween prompt heist and discover your Trick or Treat." />
    <meta name="theme-color" content="#f5f1fa" />
    <meta property="og:title" content="Caspy’s Prompt Heist" />
    <meta property="og:description" content="Three prompts. One stubborn ghost. Your sweetest heist yet." />
    <meta property="og:image" content="/images/logo.jpg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
