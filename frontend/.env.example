# Leave blank for the local frontend demo. Set an HTTPS backend to enable live API mode.
PUBLIC_API_URL=
# Public deployed Base contract address, needed for real claims.
PUBLIC_CONTRACT_ADDRESS=

# Local development: live Bifrost actor/judge, no wallet or minting.
# Run python3 scripts/heist_api.py alongside Bifrost and npm run dev.
PUBLIC_LOCAL_AI=false

# Set automatically by bash run-heist.sh --nft (local Anvil only).
PUBLIC_NFT_ENABLED=false
