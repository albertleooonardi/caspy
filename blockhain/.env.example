# Caspy's Heist Smart Contract Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =====================================================================
# DEPLOYMENT CONFIGURATION
# =====================================================================

# Deployer private key (deployer becomes owner and sets initial roles)
# Keep this extremely secure! Use a hardware wallet or HSM in production.
# Do NOT use the same key for multiple contracts or environments.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb476cad3623065be2f4ac1e9c84d

# Backend signer address (will receive SIGNER_ROLE)
# This should be a KMS-managed address in production, not an EOA.
# The signer signs EIP-712 vouchers; the private key is never stored here.
SIGNER_ADDRESS=0x1234567890123456789012345678901234567890

# =====================================================================
# CONTRACT CONFIGURATION
# =====================================================================

# Token metadata: name and symbol
CONTRACT_NAME="Caspy's Treats"
CONTRACT_SYMBOL=CASPY

# Base URI for token metadata
# Use IPFS: ipfs://QmXXX/
# Or HTTP: https://example.com/metadata/
# Token URIs will be: {BASE_URI}{tier}/{tokenId}.json
BASE_URI=ipfs://QmXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/

# Treat supply cap (number of Treat NFTs available)
# Trick NFTs are unlimited.
TREAT_SUPPLY=1000

# =====================================================================
# NETWORK & RPC CONFIGURATION
# =====================================================================

# Chain ID (8453 for Base mainnet, 84532 for Base Sepolia)
CHAIN_ID=8453

# Contract address (after deployment)
# Leave empty before deployment; set after `forge script`
CONTRACT_ADDRESS=

# RPC Endpoints (optional if configured in foundry.toml)
# Base Mainnet
BASE_MAINNET_RPC=https://mainnet.base.org

# Base Sepolia Testnet
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Localhost (for local testing with Anvil)
LOCALHOST_RPC=http://127.0.0.1:8545

# =====================================================================
# VERIFICATION & API KEYS
# =====================================================================

# Basescan API key (for contract verification on Basescan)
# Get from: https://basescan.org/apis
ETHERSCAN_API_KEY=

# =====================================================================
# KMS CONFIGURATION (Production)
# =====================================================================

# AWS KMS Configuration (if using AWS KMS for signer)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:...

# Google Cloud KMS Configuration (if using GCP)
# GCP_PROJECT_ID=
# GCP_KMS_KEY_ID=

# =====================================================================
# DEVELOPMENT & TESTING
# =====================================================================

# Enable gas reporting in tests
GAS_REPORT=true

# Enable coverage reporting
COVERAGE_REPORT=false

# Foundry fork settings (for mainnet forking)
FORK_BLOCK_NUMBER=
FORK_CHAIN_ID=

# =====================================================================
# DEPLOYMENT SCRIPT VARIABLES
# =====================================================================

# Configuration script variables (for post-deployment setup)

# New base URI to set (if updating after deployment)
# NEW_BASE_URI=

# Freeze base URI (permanent, one-way operation)
# FREEZE_BASE_URI=false

# New signer address (if rotating signer)
# NEW_SIGNER=

# New treat supply (if updating supply cap)
# NEW_TREAT_SUPPLY=2000

# =====================================================================
# NOTES
# =====================================================================

# Security Best Practices:
# 1. Use a hardware wallet (Ledger, Trezor) for deployment in production
# 2. Use KMS for the signer key (AWS KMS, GCP KMS, or similar)
# 3. Rotate signer key every 90 days or after security review
# 4. Never use the same private key for multiple contracts
# 5. Keep deployer key in a secure vault; disable after deployment
# 6. Set up 2+ multisig for admin operations (pausing, URI updates, etc.)
#
# Chain Selection:
# - Base Sepolia: Use for testing and staging
# - Base Mainnet: Use for production
#
# Supply Configuration:
# - TREAT_SUPPLY: Set to expected max winning sessions
#   Example: 1,000 Treats if you expect 10,000 sessions with 10% win rate
# - TRICK_SUPPLY: Unlimited (no cap enforced)
#
# RPC Endpoints:
# - Update RPC_URL in foundry.toml if using custom endpoints
# - Use high-availability RPC services in production (Alchemy, Infura, etc.)
#
# Verification:
# - Get Basescan API key from https://basescan.org/apis (free)
# - Verification is optional but recommended for transparency
#
# Post-Deployment:
# 1. Set CONTRACT_ADDRESS after deployment
# 2. Freeze base URI once metadata is ready
# 3. Verify contract on Basescan
# 4. Set up monitoring and alerts
# 5. Test minting flow on testnet before production
