# Caspy's Heist Smart Contract Environment Configuration

# Optional manual deployment only. Never use a public Anvil key on a public network.
# The root local NFT launcher needs no private keys.
PRIVATE_KEY=

# Backend signer address
SIGNER_ADDRESS=0x1234567890123456789012345678901234567890

# Contract configuration
CONTRACT_NAME="Caspy's Treats"
CONTRACT_SYMBOL=CASPY
BASE_URI=ipfs://QmXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/
TREAT_SUPPLY=1000

# Network configuration
CHAIN_ID=8453

# API keys
ETHERSCAN_API_KEY=

# Foundry settings
GAS_REPORT=true
