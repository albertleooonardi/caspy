# ── Bifrost gateway (LLM gateway for the Caspy API) ──────────────────────
# Copy to .env and fill in. Bifrost reads these from the process environment,
# referenced as env.<NAME> in bifrost.config.example.json.
#   cp .env.example .env   (then: source .env  / direnv / your process manager)

# First-admin setup token. Set this BEFORE creating the first admin account,
# then rotate it once the admin exists. Also accepted as the BIFROST_SETUP_TOKEN
# env var directly (alternative to setup_token in config.json).
BIFROST_SETUP_TOKEN=

# ── Provider API keys ────────────────────────────────────────────────────
# Caspy actor: fast/cheap model (e.g. Groq llama-3.1-8b-instant), temp 0.8
GROQ_API_KEY=
# Judge: stronger model (e.g. OpenAI gpt-4o), temp 0, strict-JSON verdict
OPENAI_API_KEY=
# Fallback provider for either agent (PRD: Provider A primary / Provider B fallback)
ANTHROPIC_API_KEY=

# ── Runtime governance (configured after first boot via Web UI / API) ─────
# These are NOT env vars — they are steps to perform in the Bifrost UI at
# http://localhost:8080 (or the governance API) once the gateway is up:
#   1. Create virtual keys:  vk-caspy  (Caspy actor)  and  vk-judge  (Judge).
#   2. Attach per-key budgets (PRD G4: bounded cost per wallet/agent), e.g.
#        vk-caspy -> budget, max_limit $X, reset_duration "1d"
#        vk-judge -> budget, max_limit $Y, reset_duration "1d"
#   3. Add routing rules (CEL) so Caspy turns route to groq and Judge calls to
#      openai, with anthropic as the ordered fallback chain.
# The FastAPI backend selects which budget applies per call by sending the
# `x-bf-vk` header (e.g. x-bf-vk: vk-caspy). The global-hourly / global-daily
# budgets in bifrost.config.example.json implement the PRD §9.1 global spend
# cap that triggers "Caspy is napping" maintenance mode.
