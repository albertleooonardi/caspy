# Caspy server-side Bifrost gateway. Never copy these into frontend/.env.
# Run: python3 scripts/bifrost_setup.py init
# Generates missing gateway credentials without printing them.
# Values may be plain or shell-quoted; no expansion or shell commands.
# Non-empty process environment variables override this file.

# Pin the gateway version verified by live QA.
BIFROST_TRANSPORT_VERSION=v2.4.0

# First-admin setup token (legacy BIFROST_TOKENS is migrated by init).
BIFROST_SETUP_TOKEN=
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=

# OpenRouter key: all configured actor/judge models use explicit :free IDs.
OPEN_ROUTER_API_KEY=

# Separate bearer credentials for the future FastAPI backend in x-bf-vk.
# These are secret token VALUES, not the IDs "vk-caspy" / "vk-judge".
BIFROST_CASPY_VK=
BIFROST_JUDGE_VK=

# Routes in bifrost.config.example.json:
# actor: nvidia/nemotron-3.5-lightning:free -> nvidia/nemotron-3-ultra-550b-a55b:free
# judge: nvidia/nemotron-3.5-super-vl:free -> dots-studio/dots-3-note-preview:free
# Shared OpenRouter caps: $20/hour and $200/day across both keys and fallbacks.
# Per-key caps: actor $5/day, judge $10/day; 10 requests/minute per key.
# No paid fallbacks. Free endpoints may return 429 when shared capacity is full.
# Per-wallet/session accounting belongs in the API, not these shared caps.

# Server-side only. Hugging Face token with Inference Providers permission.
# Hosted FLUX.1-dev requests require provider credits; no weights are downloaded.
HF_TOKEN=
# UTC-day limit across initial requests and explicit retries; max 3 requests per candy.
CASPY_FLUX_DAILY_LIMIT=10
