# Caspy server-side Bifrost gateway. Never copy these into frontend/.env.
# Run: python3 scripts/bifrost_setup.py init
# Generates missing gateway credentials without printing them.
# Values may be plain or shell-quoted; no expansion or shell commands.
# Non-empty process environment variables override this file.

# Pin the gateway version verified by live QA.
BIFROST_TRANSPORT_VERSION=v2.4.0

# First-admin setup token (legacy BIFROST_TOKENS is migrated by init).
BIFROST_SETUP_TOKEN=
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=

# OpenRouter key: all configured actor/judge models use explicit :free IDs.
OPEN_ROUTER_API_KEY=

# Optional Google AI Studio text provider. Keep the key server-side.
# Use a free-tier project WITHOUT billing, then explicitly set confirmation true
# and run: python3 scripts/bifrost_setup.py use-gemini
# Free-tier content may be used to improve Google's products; quotas still apply.
GEMINI_API_KEY=
CASPY_GEMINI_FREE_TIER_CONFIRMED=false

# Separate bearer credentials for the future FastAPI backend in x-bf-vk.
# These are secret token VALUES, not the IDs "vk-caspy" / "vk-judge".
BIFROST_CASPY_VK=
BIFROST_JUDGE_VK=

# Routes in bifrost.config.example.json:
# actor: nvidia/nemotron-3.5-lightning:free -> nvidia/nemotron-3-ultra-550b-a55b:free
# judge: nvidia/nemotron-3.5-super-vl:free -> dots-studio/dots-3-note-preview:free
# Shared OpenRouter caps: $20/hour and $200/day across both keys and fallbacks.
# Per-key caps: actor $5/day, judge $10/day; 10 requests/minute per key.
# No paid fallbacks. Free endpoints may return 429 when shared capacity is full.
# Per-wallet/session accounting belongs in the API, not these shared caps.

# Server-side only. Hugging Face token with Inference Providers permission.
# Hosted FLUX.1-dev requests require provider credits; no weights are downloaded.
HF_TOKEN=
# UTC-day limit across initial requests and explicit retries; max 3 requests per candy.
CASPY_FLUX_DAILY_LIMIT=10

# Offline Apple Silicon generation (no inference credits). One-time setup: bash scripts/shell/setup-flux.sh
CASPY_IMAGE_BACKEND=local-schnell
# Optional alternative: hf-dev (requires HF_TOKEN and provider credits).

# Mandatory server-side database. Never use PUBLIC_ for these credentials.
# Supabase Dashboard -> Connect -> PostgreSQL connection string.
SUPABASE_DB_URL=
# Dedicated gateway roles/schemas are generated by the migration tool.
CASPY_BF_CONFIG_HOST=
CASPY_BF_CONFIG_PORT=5432
CASPY_BF_CONFIG_USER=
CASPY_BF_CONFIG_PASSWORD=
CASPY_BF_CONFIG_DATABASE=postgres
CASPY_BF_LOGS_HOST=
CASPY_BF_LOGS_PORT=5432
CASPY_BF_LOGS_USER=
CASPY_BF_LOGS_PASSWORD=
CASPY_BF_LOGS_DATABASE=postgres

# Hosted Base Sepolia preview only. ./run.sh keeps its local defaults.
# Set these in the BACKEND hosting service, not frontend PUBLIC_ variables.
# CASPY_ENV=production
# CASPY_PUBLIC_ORIGIN=https://your-caspy-domain.example
# CASPY_API_HOST=0.0.0.0
# PORT=8000
# CASPY_NFT_ENABLED=true
# CASPY_NFT_CONFIG=/app/data/nft-sepolia.json
# CASPY_NFT_CONFIG_JSON=<confirmed public deployment JSON>
# CASPY_NFT_SIGNER_PRIVATE_KEY=<new voucher-only signer, never an Anvil key>
# Free shared demo adapter: CASPY_IMAGE_BACKEND=hf-space-schnell
# No HF_TOKEN is sent by that adapter; quotas/queues can stop generation.
